generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum PendingRegistrationStatus {
  PENDING
  VERIFIED
  INVALIDATED
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  SUPPORT_AGENT
}

enum PetCategory {
  CATS
  DOGS
  BOTH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum ShipmentStatus {
  PENDING
  MANIFESTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
}

// ==========================================
// CUSTOMER MANAGEMENT
// ==========================================

model Customer {
  id                  String        @id @default(cuid())
  fullName            String
  email               String?       @unique
  phone               String?       @unique
  passwordHash        String
  marketingConsent    Boolean       @default(false)
  emailVerified       Boolean       @default(false)
  emailVerifyToken    String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  status              AccountStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  addresses     Address[]
  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlist      Wishlist?
  subscriptions Subscription[]

  @@index([email])
  @@index([status])
}

model PendingRegistration {
  id                String                    @id @default(cuid())
  email             String
  normalizedEmail   String                    @unique
  fullName          String
  phone             String?
  passwordHash      String
  marketingConsent  Boolean                   @default(false)
  otpHash           String
  otpExpiresAt      DateTime
  failedAttempts    Int                       @default(0)
  resendCount       Int                       @default(0)
  resendWindowStart DateTime                  @default(now())
  lastResendAt      DateTime                  @default(now())
  status            PendingRegistrationStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([otpExpiresAt])
  @@index([status])
}

model Address {
  id             String   @id @default(cuid())
  customerId     String
  label          String   @default("Home")
  recipientName  String
  phone          String
  alternatePhone String?
  addressLine1   String
  addressLine2   String
  landmark       String?
  city           String
  state          String
  pincode        String
  country        String   @default("India")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([pincode])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String?
  adminId    String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  admin    AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([adminId])
  @@index([expiresAt])
}

// ==========================================
// PRODUCT & CATEGORY MANAGEMENT
// ==========================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id                          String        @id @default(cuid())
  slug                        String        @unique
  name                        String
  shortName                   String
  kicker                      String
  subtitle                    String
  description                 String
  categoryId                  String
  petCategory                 PetCategory   @default(BOTH)
  badge                       String?
  secondaryBadge              String?
  features                    String[]
  attributes                  Json?
  isFeatured                  Boolean       @default(false)
  isBestseller                Boolean       @default(false)
  subscriptionEligible        Boolean       @default(true)
  subscriptionDiscountPercent Int           @default(15)
  ratingAverage               Float         @default(0)
  reviewCount                 Int           @default(0)
  status                      ProductStatus @default(ACTIVE)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  variants          ProductVariant[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  subscriptionItems SubscriptionItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([petCategory])
  @@index([status])
  @@index([status, isFeatured])
  @@index([status, isBestseller])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  sku           String   @unique
  packSizeLabel String
  weightGrams   Int?
  price         Int
  salePrice     Int?
  pricePerUnit  String?
  stockQuantity Int      @default(0)
  isAvailable   Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]

  @@index([productId])
  @@index([sku])
}

// ==========================================
// SHOPPING CART
// ==========================================

model Cart {
  id           String   @id @default(cuid())
  customerId   String?  @unique
  guestToken   String?  @unique
  couponCode   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([guestToken])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  variantId      String
  quantity       Int      @default(1)
  isSubscription Boolean  @default(false)
  frequencyWeeks Int?     @default(4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, isSubscription])
  @@index([cartId])
}

// ==========================================
// ORDERS, PAYMENTS & SHIPPING
// ==========================================

model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  idempotencyKey         String?       @unique
  customerId             String?
  customerNameSnapshot   String
  customerEmailSnapshot  String
  customerPhoneSnapshot  String
  shippingAddressSnapshot Json
  billingInfoSnapshot    Json?
  status                 OrderStatus   @default(PENDING)
  paymentStatus          PaymentStatus @default(PENDING)
  paymentMethod          PaymentMethod @default(UPI)
  couponCode             String?
  subtotalAmount         Int
  subscriptionDiscount   Int           @default(0)
  couponDiscount         Int           @default(0)
  shippingCharge         Int           @default(0)
  taxAmount              Int           @default(0)
  totalAmount            Int
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  customer  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  shipment  Shipment?
  history   OrderStatusHistory[]

  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  variantId       String
  productName     String
  packSizeLabel   String
  sku             String
  unitPrice       Int
  discountApplied Int     @default(0)
  quantity        Int
  lineTotal       Int
  isSubscription  Boolean @default(false)
  frequencyWeeks  Int?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id                 String      @id @default(cuid())
  orderId            String
  status             OrderStatus
  note               String?
  updatedBy          String?
  carrier            String?
  trackingNumber     String?
  carrierTrackingUrl String?
  createdAt          DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  provider        String        @default("razorpay")
  gatewayOrderId  String?       @unique
  transactionId   String?       @unique
  signature       String?
  amount          Int
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  refundId        String?
  refundAmount    Int?
  refundReason    String?
  rawPayload      Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayOrderId])
}

model Shipment {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  carrier            String         @default("Delhivery Express")
  shippingMethod     String         @default("standard")
  trackingNumber     String?        @unique
  awbNumber          String?
  carrierTrackingUrl String?
  status             ShipmentStatus @default(PENDING)
  estimatedDelivery  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  trackingUpdates    Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ==========================================
// DISCOUNTS & COUPONS
// ==========================================

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Int
  minOrderValue    Int          @default(0)
  maxDiscountCap   Int?
  usageLimit       Int?
  usedCount        Int          @default(0)
  customerOnly     Boolean      @default(false)
  startsAt         DateTime?
  expiresAt        DateTime?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([code])
}

// ==========================================
// REVIEWS & WISHLIST
// ==========================================

model Review {
  id         String       @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  title      String?
  comment    String
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@index([productId])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

// ==========================================
// SUBSCRIBE & SAVE
// ==========================================

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   @unique
  frequencyWeeks  Int      @unique
  discountPercent Int      @default(15)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  customerId           String
  planId               String
  gatewaySubscriptionId String?           @unique
  status               SubscriptionStatus @default(ACTIVE)
  discountPercent      Int                @default(15)
  nextBillingDate      DateTime
  nextDeliveryDate     DateTime
  shippingAddressJson  Json
  pausedUntil          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan      @relation(fields: [planId], references: [id])
  items    SubscriptionItem[]
  history  SubscriptionHistory[]

  @@index([customerId])
  @@index([status])
}

model SubscriptionItem {
  id             String @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String
  quantity       Int    @default(1)
  unitPrice      Int

  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])
  variant      ProductVariant @relation(fields: [variantId], references: [id])

  @@index([subscriptionId])
}

model SubscriptionHistory {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  details        String?
  amountCharged  Int?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ==========================================
// ADMINISTRATION & AUDIT LOGGING
// ==========================================

model AdminUser {
  id           String        @id @default(cuid())
  fullName     String
  email        String        @unique
  passwordHash String
  role         AdminRole     @default(CATALOG_MANAGER)
  permissions  String[]
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entityType, entityId])
}
